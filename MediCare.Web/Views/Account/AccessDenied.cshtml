@* Access denied — GET /Account/AccessDenied?ReturnUrl=
   Shown by the Identity cookie (AccessDeniedPath) when a signed-in user opens a page for another role
   (e.g. a Doctor opens /MyAppointments, a Patient opens /DoctorAppointments). Vitala style. *@
@{
    Layout = "_VitalaLayout";
    ViewData["Title"] = "Access denied";

    var signedIn = User.Identity?.IsAuthenticated == true;
    var role = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Doctor") ? "Doctor" : User.IsInRole("Patient") ? "Patient" : null;
    // The right home for this user's role.
    var (homeController, homeAction, homeText) = role switch
    {
        "Doctor"  => ("DoctorAppointments", "Index", "Go to my appointments"),
        "Patient" => ("Patient", "Home", "Go to my dashboard"),
        "Admin"   => ("Admin", "Dashboard", "Go to admin"),
        _         => ("Home", "Index", "Back to home"),
    };
    var returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    if (string.IsNullOrEmpty(returnUrl) || !Url.IsLocalUrl(returnUrl)) { returnUrl = null; }
}
<main class="vt-denied">
    <a class="vt-denied__brand" asp-controller="Home" asp-action="Index">
        <img src="~/images/vitala/logo.png" width="29" height="31" alt="" /> vitala
    </a>

    <section class="vt-denied__card" aria-labelledby="vt-denied-title">
        <span class="vt-denied__icon"><partial name="_VtIcon" model='"alert:34"' /></span>
        <span class="vt-denied__code">403</span>
        <h1 class="vt-denied__title" id="vt-denied-title">Access denied</h1>
        <p class="vt-denied__text">
            You don't have permission to view this page.
            @if (role is not null)
            {
                <text>It isn't available to <strong>@role</strong> accounts.</text>
            }
        </p>

        @if (signedIn)
        {
            <p class="vt-denied__user">
                <partial name="_VtIcon" model='"user:16"' />
                Signed in as <strong>@(User.FindFirst("FullName")?.Value ?? User.Identity!.Name)</strong>
            </p>
        }

        <div class="vt-denied__actions">
            <a class="vt-btn vt-btn--primary" asp-controller="@homeController" asp-action="@homeAction">@homeText</a>
            @if (signedIn)
            {
                @* Sign out (POST + anti-forgery token), then the login page can be used with another account. *@
                <form class="vt-inline-form" method="post" asp-controller="Account" asp-action="Logout">
                    <button type="submit" class="vt-btn vt-btn--outline">Use another account</button>
                </form>
            }
            else
            {
                <a class="vt-btn vt-btn--outline" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">Log in</a>
            }
        </div>
    </section>
</main>
