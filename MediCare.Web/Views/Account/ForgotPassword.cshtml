@* Forgot Password: first step of the recovery flow (Email → Verify OTP → Reset Password).
   Not in the Figma file; built from the same auth components so the flow has no dead end.
   Fields posted: Email
*@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
    ViewData["AuthPanelTitle"] = "Password Recovery";
}
<h1 class="vt-auth__title">Forgot password</h1>
<p class="vt-auth__lead">Enter the email linked to your account and we’ll send you a verification code.</p>

<form method="post" asp-controller="Account" asp-action="ForgotPassword" novalidate>
    <div asp-validation-summary="ModelOnly" class="vt-field-error"></div>

    <div class="vt-field">
        <label class="vt-label" for="Email">Email Address</label>
        <input class="vt-input" id="Email" name="Email" type="email" autocomplete="email" required
               data-val="true" data-val-required="Email is required." data-val-email="Enter a valid email address." />
        <span class="vt-field-error" data-valmsg-for="Email" data-valmsg-replace="true"></span>
    </div>

    <button type="submit" class="vt-btn vt-btn--primary vt-btn--block vt-auth__submit">Send code</button>
</form>

<p class="vt-auth__footer">
    <a asp-controller="Account" asp-action="Login">Back to login</a>
</p>
