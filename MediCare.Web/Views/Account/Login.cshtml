@* 03 — Login
   Fields posted: Email, Password, ReturnUrl (hidden).
   ReturnUrl comes from ?returnUrl= (set by [Authorize] redirects), or from Model/ModelState when the
   POST action returns View(model). Only local URLs are kept; the backend should still check Url.IsLocalUrl.
   After a failed POST the Email is refilled and server field errors are shown. No @model needed.
*@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Log in";
    ViewData["AuthPanelTitle"] = "Welcome Back to Vitala";

    // Value posted back for a field: Model.<name> first, then what the user typed (ModelState).
    string? Posted(string name)
    {
        var model = ViewData.Model;
        if (model?.GetType().GetProperty(name)?.GetValue(model) is string fromModel && fromModel.Length > 0)
            return fromModel;
        return ViewData.ModelState.TryGetValue(name, out var entry) ? entry?.AttemptedValue : null;
    }
    string? ServerError(string name) =>
        ViewData.ModelState.TryGetValue(name, out var entry) ? entry?.Errors.FirstOrDefault()?.ErrorMessage : null;

    var returnUrl = Posted("ReturnUrl") ?? Context.Request.Query["returnUrl"].ToString();
    if (string.IsNullOrEmpty(returnUrl) || !Url.IsLocalUrl(returnUrl)) { returnUrl = null; }
    ViewData["ReturnUrl"] = returnUrl; // used by _GoogleSignIn
}
<h1 class="vt-auth__title">Log in</h1>

<form method="post" asp-controller="Account" asp-action="Login" novalidate>
    <div asp-validation-summary="ModelOnly" class="vt-field-error"></div>
    @if (returnUrl is not null)
    {
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
    }

    <div class="vt-field">
        <label class="vt-label" for="Email">Email Address</label>
        <input class="vt-input" id="Email" name="Email" type="email" autocomplete="email" value="@Posted("Email")" required
               data-val="true" data-val-required="Email is required." data-val-email="Enter a valid email address." />
        <span class="vt-field-error" data-valmsg-for="Email" data-valmsg-replace="true">@ServerError("Email")</span>
    </div>

    <div class="vt-field">
        <label class="vt-label" for="Password">Password</label>
        <div class="vt-input-wrap">
            <input class="vt-input vt-input--with-icon" id="Password" name="Password" type="password" autocomplete="current-password" required
                   data-val="true" data-val-required="Password is required." />
            <partial name="_PasswordToggle" model='"#Password"' />
        </div>
        <span class="vt-field-error" data-valmsg-for="Password" data-valmsg-replace="true">@ServerError("Password")</span>
    </div>

    <div class="vt-auth__row-end">
        <a class="vt-link-muted" asp-controller="Account" asp-action="ForgotPassword">Forget Password?</a>
    </div>

    <button type="submit" class="vt-btn vt-btn--primary vt-btn--block vt-auth__submit">Log in</button>
</form>

<partial name="_GoogleSignIn" />

<p class="vt-auth__footer">
    <a asp-controller="Account" asp-action="SelectRole">Don’t have an Account? sign up</a>
</p>
