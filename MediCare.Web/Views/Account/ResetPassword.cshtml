@* 06 — Reset Password (create new password)
   Fields posted: NewPassword, ConfirmPassword
   If the reset flow needs a token/email, add hidden inputs here (e.g. <input type="hidden" name="Token" value="..." />).
*@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create new password";
    ViewData["AuthPanelTitle"] = "Password Recovery";
}
<h1 class="vt-auth__title">Create new password</h1>

<form method="post" asp-controller="Account" asp-action="ResetPassword" novalidate>
    <div asp-validation-summary="ModelOnly" class="vt-field-error"></div>

    <div class="vt-field">
        <label class="vt-label" for="NewPassword">New Password</label>
        <div class="vt-input-wrap">
            <input class="vt-input vt-input--with-icon" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" required
                   data-val="true" data-val-required="New password is required."
                   data-val-minlength="Password must be at least 6 characters." data-val-minlength-min="6" />
            <partial name="_PasswordToggle" model='"#NewPassword"' />
        </div>
        <span class="vt-field-error" data-valmsg-for="NewPassword" data-valmsg-replace="true"></span>
    </div>

    <div class="vt-field">
        <label class="vt-label" for="ConfirmPassword">Confirm Password</label>
        <input class="vt-input" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required
               data-val="true" data-val-required="Please confirm your password."
               data-val-equalto="Passwords do not match." data-val-equalto-other="*.NewPassword" />
        <span class="vt-field-error" data-valmsg-for="ConfirmPassword" data-valmsg-replace="true"></span>
    </div>

    <button type="submit" class="vt-btn vt-btn--primary vt-btn--block vt-auth__submit">Confirm Password</button>
</form>
