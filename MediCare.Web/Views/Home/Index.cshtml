@* 01 — Web Landing Hero *@
@{
    Layout = "_VitalaLayout";
    ViewData["Title"] = "";

    // Signed-in state (ASP.NET Core Identity): show the user's name + Log out instead of Log In / Get Started.
    var signedIn = User.Identity?.IsAuthenticated == true;
    var role = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Doctor") ? "Doctor" : User.IsInRole("Patient") ? "Patient" : null;
    // Where "Go to Dashboard" leads for each role (Admin has no dashboard yet, so the button is hidden).
    var dashController = role == "Doctor" ? "DoctorAppointments" : "Patient";
    var dashAction = role == "Doctor" ? "Index" : "Home";
    var showDashboard = signedIn && role != "Admin";
    // "My Appointments": doctors see their own schedule; patient pages are Patient-only.
    var appointmentsController = role == "Doctor" ? "DoctorAppointments" : "MyAppointments";
}
<div class="vt-landing">
    <div class="vt-landing__inner">

        <header class="vt-nav">
            <a class="vt-brand" asp-controller="Home" asp-action="Index">
                <img class="vt-brand__logo" src="~/images/vitala/logo.png" width="29" height="31" alt="" />
                <span class="vt-brand__text">
                    <span class="vt-brand__name">vitala</span>
                    <span class="vt-brand__tagline">Connecting You To Better Health</span>
                </span>
            </a>

            <button type="button" class="vt-nav__toggle" data-vt-nav-toggle="#vt-nav-menu" aria-controls="vt-nav-menu" aria-expanded="false" aria-label="Toggle navigation">
                <partial name="_VtIcon" model='"menu:28"' />
            </button>

            @* The menu is split from the brand only so it can collapse on mobile *@
            <div class="vt-nav__menu" id="vt-nav-menu">
                <nav aria-label="Primary">
                    <ul class="vt-nav__links">
                        <li><a class="is-active" asp-controller="Home" asp-action="Index" aria-current="page">Home</a></li>
                        <li><a asp-controller="Doctors" asp-action="Index">Find Specialist</a></li>
                        <li><a asp-controller="@appointmentsController" asp-action="Index">My Appointments</a></li>
                        <li><a asp-controller="Patient" asp-action="AiAssistant">AI Assistant</a></li>
                    </ul>
                </nav>
                <div class="vt-nav__actions">
                    @if (signedIn)
                    {
                        <span class="vt-nav__user" title="@User.Identity!.Name">
                            <partial name="_VtIcon" model='"user:18"' />
                            <span class="vt-nav__user-name">@User.Identity!.Name</span>
                            @if (role is not null)
                            {
                                <span class="vt-nav__role">@role</span>
                            }
                        </span>
                        @* Log out must be a POST with the anti-forgery token (added by the form tag helper), not a link. *@
                        <form class="vt-inline-form" method="post" asp-controller="Account" asp-action="Logout">
                            <button type="submit" class="vt-btn vt-btn--outline-light">Log Out</button>
                        </form>
                    }
                    else
                    {
                        <a class="vt-btn vt-btn--outline-light" asp-controller="Account" asp-action="Login">Log In</a>
                        <a class="vt-btn vt-btn--white" asp-controller="Account" asp-action="SelectRole">Get Started</a>
                    }
                </div>
            </div>
        </header>

        <section class="vt-hero">
            <div>
                <span class="vt-pill">All-in-one healthcare web platform</span>
                <h1 class="vt-hero__title">Connecting You To <span>Better Health.</span></h1>
                <p class="vt-hero__text">
                    Book appointments with top specialists, locate nearby pharmacies,
                    and stay connected with trusted healthcare providers.
                </p>
                <div class="vt-hero__cta">
                    @if (showDashboard)
                    {
                        <a class="vt-btn vt-btn--white vt-btn--lg" asp-controller="@dashController" asp-action="@dashAction">Go to Dashboard</a>
                    }
                    else if (!signedIn)
                    {
                        <a class="vt-btn vt-btn--white vt-btn--lg" asp-controller="Account" asp-action="SelectRole">Get Started Free</a>
                        <a class="vt-btn vt-btn--glass vt-btn--lg" asp-controller="Account" asp-action="Login">Sign In to Portal</a>
                    }
                </div>
            </div>

            <div class="vt-glass-card">
                @* Featured doctor — static content, replace with model data when available *@
                <div class="vt-doctor-highlight">
                    <div class="vt-doctor-highlight__photo">
                        <img src="~/images/vitala/doctor-sarah-jenkins.png" width="74" height="76" alt="Dr. Sarah Jenkins" />
                    </div>
                    <div>
                        <span class="vt-eyebrow">Verified Specialists</span>
                        <h2 class="vt-doctor-highlight__name">Dr. Sarah Jenkins</h2>
                        <p class="vt-doctor-highlight__meta">Cardiology &amp; Internal Medicine • 4.9 ★</p>
                    </div>
                </div>
                <div class="vt-stat-grid">
                    <div class="vt-stat"><strong>500+ Doctors</strong><span>Instant Booking</span></div>
                    <div class="vt-stat"><strong>24/7 Pharmacy</strong><span>Nearby Medicines</span></div>
                </div>
            </div>
        </section>

        <section class="vt-features" aria-label="Features">
            <a class="vt-feature" id="find-specialist" asp-controller="Doctors" asp-action="Index">
                <span class="vt-feature__icon">
                    <img src="~/images/vitala/feature-find-specialist.png" alt="" width="65" height="67" />
                </span>
                <h3 class="vt-feature__title">Find Your Specialist</h3>
                <p class="vt-feature__text">Book appointments with top doctors easily.</p>
            </a>
            <a class="vt-feature" id="my-appointments" asp-controller="MyAppointments" asp-action="Index">
                <span class="vt-feature__icon">
                    @* Figma card was "Search Pharmacy" (removed from scope); its image is ~/images/vitala/feature-search-pharmacy.png *@
                    <partial name="_VtIcon" model='"calendar:34"' />
                </span>
                <h3 class="vt-feature__title">Manage Appointments</h3>
                <p class="vt-feature__text">Track or cancel your bookings in one place.</p>
            </a>
            <a class="vt-feature" id="ai-assistant" asp-controller="Patient" asp-action="AiAssistant">
                <span class="vt-feature__icon">
                    <img src="~/images/vitala/feature-get-connected.png" alt="" width="70" height="68" />
                </span>
                <h3 class="vt-feature__title">Get Connected</h3>
                <p class="vt-feature__text">Stay connected with healthcare providers.</p>
            </a>
        </section>
    </div>
</div>
