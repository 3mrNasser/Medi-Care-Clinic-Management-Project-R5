@using MediCare.Data.Enums
@model IEnumerable<MediCare.Services.DTOs.AppointmentDto>

@{
    ViewData["Title"] = "My appointments";
}

<h2>My appointments</h2>

@if (TempData["Error"] is string error)
{
    <p style="color:red">@error</p>
}

@if (TempData["Success"] is string success)
{
    <p style="color:green">@success</p>
}

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Doctor</th>
            <th>Reason</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Date.ToString("yyyy-MM-dd")</td>
                <td>@a.StartTime.ToString("HH:mm")</td>
                <td>@a.DoctorName</td>
                <td>@a.Reason</td>
                <td>@a.Status</td>
                <td>
                    @if (a.Status == AppointmentStatus.Pending || a.Status == AppointmentStatus.Confirmed)
                    {
                        <a asp-action="Reschedule" asp-route-appointmentId="@a.Id">Reschedule</a>
                        <form method="post" asp-action="Cancel" style="display:inline">
                            <input type="hidden" name="appointmentId" value="@a.Id" />
                            <button type="submit">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>