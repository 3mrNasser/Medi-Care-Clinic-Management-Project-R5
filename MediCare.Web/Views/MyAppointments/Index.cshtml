@using MediCare.Data.Enums
@model IEnumerable<MediCare.Services.DTOs.AppointmentDto>
@* Patient appointments — GET /MyAppointments, POST MyAppointments/Cancel (appointmentId). Vitala style. *@
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Appointments";
    ViewData["ActiveNav"] = "Appointments";
    var today = DateOnly.FromDateTime(DateTime.Now);
    bool IsActive(AppointmentStatus s) => s == AppointmentStatus.Pending || s == AppointmentStatus.Confirmed;
    var all = Model.ToList(); // enumerate once: a deferred sequence would create new objects and break Except
    var upcoming = all.Where(a => IsActive(a.Status) && a.Date >= today).OrderBy(a => a.Date).ThenBy(a => a.StartTime).ToList();
    var others = all.Except(upcoming).OrderByDescending(a => a.Date).ThenByDescending(a => a.StartTime).ToList();
}

<header class="vt-page-head">
    <button type="button" class="vt-menu-btn" data-vt-sidebar-open aria-controls="vt-sidebar" aria-label="Open menu">
        <partial name="_VtIcon" model='"menu"' />
    </button>
    <div class="vt-page-head__text">
        <h1 class="vt-page-title">My Appointments</h1>
        <p class="vt-page-sub">Your bookings and their status.</p>
    </div>
    <div class="vt-page-actions">
        <a class="vt-btn vt-btn--outline vt-btn--sm" asp-controller="MyPrescriptions" asp-action="Index">
            <partial name="_VtIcon" model='"pill:18"' /> My prescriptions
        </a>
        <a class="vt-btn vt-btn--primary vt-btn--sm" asp-controller="Doctors" asp-action="Index">
            <partial name="_VtIcon" model='"plus:18"' /> Book new
        </a>
    </div>
</header>

<partial name="_VtAlerts" />

@if (!all.Any())
{
    <section class="vt-empty">
        <span class="vt-empty__icon vt-empty__icon--navy"><partial name="_VtIcon" model='"calendar:30"' /></span>
        <h2 class="vt-empty__title">No appointments yet</h2>
        <p class="vt-empty__text">Find a specialist and book your first appointment.</p>
        <a class="vt-btn vt-btn--primary vt-btn--sm" asp-controller="Doctors" asp-action="Index">Find a doctor</a>
    </section>
}
else
{
    @if (upcoming.Any())
    {
        <h2 class="vt-section-label">Upcoming</h2>
        <div class="vt-list">
            @foreach (var a in upcoming)
            {
                <partial name="_PatientAppointmentRow" model="a" />
            }
        </div>
    }
    @if (others.Any())
    {
        <h2 class="vt-section-label">Past &amp; other</h2>
        <div class="vt-list">
            @foreach (var a in others)
            {
                <partial name="_PatientAppointmentRow" model="a" />
            }
        </div>
    }
}
