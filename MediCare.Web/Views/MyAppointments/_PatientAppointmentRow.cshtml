@using MediCare.Data.Enums
@model MediCare.Services.DTOs.AppointmentDto
<article class="vt-row">
    <div class="vt-date" aria-hidden="true">
        <span class="vt-date__day">@Model.Date.Day</span>
        <span class="vt-date__mon">@Model.Date.ToString("MMM")</span>
    </div>
    <div>
        <h3 class="vt-row__title">@Model.DoctorName</h3>
        <div class="vt-row__meta">
            <span><partial name="_VtIcon" model='"calendar:15"' /> @Model.Date.ToString("ddd, d MMM yyyy")</span>
            <span><partial name="_VtIcon" model='"clock:15"' /> @Model.StartTime.ToString("HH:mm")</span>
            <span class="vt-chip-type">@Model.TypeName</span>
            @if (!string.IsNullOrWhiteSpace(Model.Reason))
            {
                <span>“@Model.Reason”</span>
            }
        </div>
    </div>
    <div class="vt-row__actions">
        <partial name="_VtStatusBadge" model="Model.Status" />
        @if (Model.Status == AppointmentStatus.Pending || Model.Status == AppointmentStatus.Confirmed)
        {
            <a class="vt-btn vt-btn--outline vt-btn--xs" asp-controller="MyAppointments" asp-action="Reschedule" asp-route-appointmentId="@Model.Id">Reschedule</a>
            <form method="post" asp-controller="MyAppointments" asp-action="Cancel" class="vt-inline-form"
                  data-vt-confirm="Cancel your appointment with @Model.DoctorName on @Model.Date.ToString("d MMM") at @Model.StartTime.ToString("HH:mm")?">
                <input type="hidden" name="appointmentId" value="@Model.Id" />
                <button type="submit" class="vt-btn vt-btn--danger vt-btn--xs">Cancel</button>
            </form>
        }
    </div>
</article>
