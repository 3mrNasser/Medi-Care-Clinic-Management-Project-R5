@*
    Split-screen layout for Login / Sign up / Forgot password / Verify OTP / Reset password.
    Set the left panel text from the view:  ViewData["AuthPanelTitle"] = "Welcome Back to Vitala";
    Loads jQuery + unobtrusive validation so the data-val-* rules on the inputs run before submit.
*@
@{
    Layout = "_VitalaLayout";
}
<div class="vt-auth">
    <aside class="vt-auth__panel">
        <h2 class="vt-auth__panel-title">@ViewData["AuthPanelTitle"]</h2>
    </aside>
    <main class="vt-auth__main">
        <div class="vt-auth__inner">
            @RenderBody()
        </div>
    </main>
</div>

@section Styles { @await RenderSectionAsync("Styles", required: false) }
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
}
