@model string
@*
    Inline SVG icon set (stroke icons, inherit `currentColor`).
    Usage:  <partial name="_VtIcon" model='"bell"' />        → 24px
            <partial name="_VtIcon" model='"doctor:40"' />   → 40px
    Swap any icon for the team's PNGs (e.g. ~/images/icons/medical-team.png) when they're ready.
*@
@{
    var parts = (Model ?? "").Split(':');
    var name = parts[0];
    var size = parts.Length > 1 ? parts[1] : "24";
}
<svg xmlns="http://www.w3.org/2000/svg" width="@size" height="@size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
@switch (name)
{
    case "eye":
        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" fill="currentColor" stroke="none" /><circle cx="12" cy="12" r="4.2" fill="#fff" stroke="none" /><circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
        break;
    case "eye-off":
        <path d="M3 3l18 18" /><path d="M10.6 5.1A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6C3.7 8.4 2 12 2 12s3.6 7 10 7c1.8 0 3.4-.5 4.7-1.3" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
        break;
    case "search":
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        break;
    case "bell":
        <path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0" />
        break;
    case "user":
        <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
        break;
    case "home":
        <path d="M3 10.5 12 3l9 7.5" /><path d="M5 9v12h14V9" /><path d="M10 21v-6h4v6" />
        break;
    case "calendar":
        <rect x="3" y="4.5" width="18" height="16.5" rx="2.5" /><path d="M8 2.5v4M16 2.5v4M3 10h18" />
        break;
    case "cart":
        <circle cx="9" cy="20" r="1.4" /><circle cx="18" cy="20" r="1.4" /><path d="M2.5 3h2.6l2.4 12.2a1.5 1.5 0 0 0 1.5 1.2h8.8a1.5 1.5 0 0 0 1.5-1.2L21 7H6" />
        break;
    case "bot":
        <rect x="4" y="8" width="16" height="12" rx="3" /><path d="M12 8V4.5" /><circle cx="12" cy="3.5" r="1" /><circle cx="9" cy="14" r="1.2" fill="currentColor" /><circle cx="15" cy="14" r="1.2" fill="currentColor" /><path d="M2 13v3M22 13v3" />
        break;
    case "check-circle":
        <circle cx="12" cy="12" r="9.5" /><path d="m8 12.5 2.7 2.7L16.5 9" />
        break;
    case "alert":
        <circle cx="12" cy="12" r="9.5" /><path d="M12 7.5v5.5" /><path d="M12 16.5h.01" stroke-width="2.6" />
        break;
    case "clock":
        <circle cx="12" cy="12" r="9.5" /><path d="M12 7v5l3.5 2" />
        break;
    case "pin":
        <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" />
        break;
    case "print":
        <path d="M6 9V3h12v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M6 14h12v7H6z" />
        break;
    case "plus":
        <path d="M12 5v14M5 12h14" />
        break;
    case "trash":
        <path d="M4 7h16M10 11v6M14 11v6" /><path d="M6 7l1 13h10l1-13M9 7V4h6v3" />
        break;
    case "list":
        <path d="M9 6h11M9 12h11M9 18h11" /><path d="M4 6h.01M4 12h.01M4 18h.01" stroke-width="2.6" />
        break;
    case "pill":
        <rect x="3" y="8" width="18" height="8" rx="4" transform="rotate(-45 12 12)" /><path d="m8.5 8.5 7 7" />
        break;
    case "back":
        <path d="M19 12H5M11 6l-6 6 6 6" />
        break;
    case "indent":
        <path d="M4 5h16M10 10h10M10 14h10M4 19h16" /><path d="m4 9 3 3-3 3" />
        break;
    case "menu":
        <path d="M4 6h16M4 12h16M4 18h10" />
        break;
    case "close":
        <path d="M6 6l12 12M18 6 6 18" />
        break;
    case "arrow-right":
        <path d="M5 12h14M13 6l6 6-6 6" />
        break;
    case "doctor":
        <circle cx="12" cy="6.5" r="3.5" /><path d="M5 21v-3a7 7 0 0 1 14 0v3" /><path d="M9 13.5v3a2 2 0 0 0 4 0" /><circle cx="16" cy="17.5" r="1.2" /><path d="M16 14v2.3" />
        break;
    case "pharmacy":
        <rect x="3" y="8" width="18" height="10" rx="5" transform="rotate(-45 12 13)" /><path d="m8.5 9.5 6 6" />
        break;
    case "pharmacist":
        <circle cx="12" cy="6.5" r="3.5" /><path d="M5 21v-3a7 7 0 0 1 14 0v3" /><path d="M12 14.5v4M10 16.5h4" />
        break;
    case "admin":
        <path d="M12 2.5 4 5.5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10v-6l-8-3Z" /><path d="m9 12 2 2 4-4" />
        break;
    case "patient":
        <circle cx="12" cy="7" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /><path d="M12 14v4M10 16h4" />
        break;
    case "reward":
        <circle cx="12" cy="9" r="6" /><path d="m8.5 14 -1.5 7.5 5-2.5 5 2.5-1.5-7.5" /><path d="m12 6.2.9 1.8 2 .3-1.5 1.4.4 2-1.8-1-1.8 1 .4-2-1.5-1.4 2-.3Z" />
        break;
    case "labs":
        <path d="M9 3h6M10 3v6.5L4.6 18.4A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.4-2.6L14 9.5V3" /><path d="M7 15h10" />
        break;
    case "consult":
        <rect x="2.5" y="4" width="19" height="13" rx="2" /><path d="M8 21h8M12 17v4" /><path d="M12 7.5v6M9 10.5h6" />
        break;
    case "history":
        <rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 3v2h6V3" /><path d="M9 11h6M9 15h4" />
        break;
    case "heart":
        <path d="M12 20s-7.5-4.4-9.3-9A5 5 0 0 1 12 6a5 5 0 0 1 9.3 5c-1.8 4.6-9.3 9-9.3 9Z" /><path d="M3.5 12h4l1.5-3 3 6 1.5-3h7" />
        break;
    case "brain":
        <path d="M9.5 3A3 3 0 0 0 6.6 5.3 3 3 0 0 0 4 8.2a3 3 0 0 0 .6 3.3A3.3 3.3 0 0 0 5.5 17a3 3 0 0 0 4 3.5V3.6A3 3 0 0 0 9.5 3Z" /><path d="M14.5 3a3 3 0 0 1 2.9 2.3A3 3 0 0 1 20 8.2a3 3 0 0 1-.6 3.3 3.3 3.3 0 0 1-.9 5.5 3 3 0 0 1-4 3.5V3.6A3 3 0 0 1 14.5 3Z" />
        break;
    case "skin":
        <path d="M12 2.5c3.5 4 6 7.3 6 10.5a6 6 0 0 1-12 0c0-3.2 2.5-6.5 6-10.5Z" /><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5" />
        break;
    case "baby":
        <circle cx="12" cy="11" r="8" /><path d="M9 10h.01M15 10h.01" stroke-width="2.6" /><path d="M9.5 14a3.5 3.5 0 0 0 5 0" /><path d="M12 3a2 2 0 0 0 2 2" />
        break;
    case "bone":
        <path d="M16.5 3.5a2.5 2.5 0 0 1 2.4 3.1 2.5 2.5 0 1 1-1.6 4.6L11.2 17.3a2.5 2.5 0 1 1-4.6 1.6 2.5 2.5 0 1 1-1.6-4.6l6.1-6.1a2.5 2.5 0 0 1 2.3-4.7c.4 0 .8.1 1.2.3a2.5 2.5 0 0 1 1.9-.3Z" />
        break;
    case "eye-care":
        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" />
        break;
    case "logout":
        <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" /><path d="M10 17l-5-5 5-5" /><path d="M5 12h11" />
        break;
    case "connect":
        <path d="M21 12a8.5 8.5 0 0 1-12.4 7.6L3 21l1.4-5.4A8.5 8.5 0 1 1 21 12Z" /><path d="M8 12h.01M12 12h.01M16 12h.01" stroke-width="2.6" />
        break;
}
</svg>
