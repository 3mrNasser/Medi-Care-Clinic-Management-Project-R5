@*
    Base layout for all Vitala screens.
    Kept separate from the team's _Layout.cshtml so the Bootstrap navbar/footer
    don't wrap these full-screen designs. Views opt in with:
        Layout = "_VitalaLayout";   (or _AuthLayout / _DashboardLayout, which nest inside this one)
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " · Vitala" : "Vitala — Connecting You To Better Health")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/vitala.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="vt-body @ViewData["BodyClass"]">
    @RenderBody()

    <script src="~/js/vitala.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
