@model string
@* Eye button that shows/hides the password input given as a CSS selector (e.g. "#Password"). *@
<button type="button" class="vt-eye" data-vt-toggle-password="@Model" aria-label="Show password" aria-pressed="false">
    <span class="vt-eye__on"><partial name="_VtIcon" model='"eye:30"' /></span>
    <span class="vt-eye__off"><partial name="_VtIcon" model='"eye-off:28"' /></span>
</button>
