@model string
@* Eye button that shows/hides the password input given as a CSS selector (e.g. "#Password").
   Closed state uses the eye image exported from Figma. *@
<button type="button" class="vt-eye" data-vt-toggle-password="@Model" aria-label="Show password" aria-pressed="false">
    <span class="vt-eye__on"><img src="~/images/vitala/eye.png" width="24" height="24" alt="" /></span>
    <span class="vt-eye__off"><partial name="_VtIcon" model='"eye-off:24"' /></span>
</button>
