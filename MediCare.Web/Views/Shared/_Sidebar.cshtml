@inject MediCare.Services.Interfaces.INotificationService NotificationService
@{
    var active = ViewData["ActiveNav"] as string ?? "";
    // Unread notifications for the badge (patients and doctors). Updated live by vitala.js when a new one arrives.
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var unreadCount = userId is not null && (User.IsInRole("Patient") || User.IsInRole("Doctor"))
        ? await NotificationService.GetUnreadCountAsync(userId)
        : 0;
    // Image = icon exported from Figma; otherwise an inline SVG icon.
    var home          = (Key: "Home",          Text: "Home",          Controller: "Patient",        Action: "Home",          Image: (string?)"~/images/vitala/icon-home.png",          Icon: "home");
    var appointments  = (Key: "Appointments",  Text: "Appointments",  Controller: "MyAppointments", Action: "Index",         Image: (string?)null,                                     Icon: "calendar");
    var records       = (Key: "MedicalRecords", Text: "Medical Records", Controller: "MyMedicalRecords", Action: "Index", Image: (string?)null,                             Icon: "history");
    var documents     = (Key: "Documents",      Text: "Documents",       Controller: "Documents",      Action: "Index", Image: (string?)null, Icon: "list");
    var profile       = (Key: "PatientProfile", Text: "My Profile",      Controller: "PatientProfile", Action: "Index", Image: (string?)null, Icon: "user");
    var cart          = (Key: "Cart",        Text: "Cart",          Controller: "Patient",        Action: "Cart",          Image: (string?)"~/images/vitala/icon-cart.png",          Icon: "cart");
    var notifications = (Key: "Notifications", Text: "Notifications", Controller: "Notifications",  Action: "Index",         Image: (string?)"~/images/vitala/icon-notifications.png", Icon: "bell");

    // Patient menu (the AI Assistant was removed from scope).
    var items = new[] { home, appointments, records, documents, profile, cart, notifications };

    // Doctor pages (ViewData["SidebarRole"] = "Doctor"): doctor menu.
    // The signed-in doctor is read from the login cookie by the backend, so no doctorId in the URL.
    var isDoctor = ViewData["SidebarRole"] as string == "Doctor";
    if (isDoctor)
    {
        items = new[]
        {
            (Key: "DoctorAppointments", Text: "Appointments",  Controller: "DoctorAppointments", Action: "Index", Image: (string?)null, Icon: "calendar"),
            (Key: "Availability",       Text: "Working Hours", Controller: "Availability",       Action: "Index", Image: (string?)null, Icon: "clock"),
            (Key: "DoctorProfile",      Text: "My Profile",    Controller: "DoctorProfile",      Action: "Index", Image: (string?)null, Icon: "user"),
            notifications,
        };
    }
    // Admin pages (ViewData["SidebarRole"] = "Admin").
    if (ViewData["SidebarRole"] as string == "Admin")
    {
        items = new[]
        {
            (Key: "AdminDashboard",       Text: "Dashboard",       Controller: "Admin", Action: "Dashboard",       Image: (string?)null, Icon: "list"),
            (Key: "AdminDoctors",         Text: "Doctors",         Controller: "Admin", Action: "Doctors",         Image: (string?)null, Icon: "doctor"),
            (Key: "AdminPatients",        Text: "Patients",        Controller: "Admin", Action: "Patients",        Image: (string?)null, Icon: "user"),
            (Key: "AdminAppointments",    Text: "Appointments",    Controller: "Admin", Action: "Appointments",    Image: (string?)null, Icon: "calendar"),
            (Key: "AdminSpecializations", Text: "Specializations", Controller: "Admin", Action: "Specializations", Image: (string?)null, Icon: "heart"),
        };
    }
}
<aside class="vt-sidebar" id="vt-sidebar" aria-label="Main navigation">
    <a class="vt-sidebar__brand" asp-controller="Home" asp-action="Index">
        <img class="vt-brand__logo" src="~/images/vitala/logo.png" width="29" height="31" alt="" />
        vitala
    </a>
    <button type="button" class="vt-sidebar__close" data-vt-sidebar-close aria-label="Close menu">
        <partial name="_VtIcon" model='"close"' />
    </button>
    <ul class="vt-sidebar__nav">
        @foreach (var item in items)
        {
            var isActive = item.Key == active;
            <li>
                <a class="vt-sidebar__link @(isActive ? "is-active" : "")"
                   asp-controller="@item.Controller" asp-action="@item.Action"
                   aria-current="@(isActive ? "page" : null)">
                    <span class="vt-sidebar__icon">
                        @if (item.Image is not null)
                        {
                            var isHome = item.Key == "Home";
                            <img src="@Url.Content(item.Image)" width="@(isHome ? 16 : 20)" height="@(isHome ? 18 : 20)" alt="" />
                        }
                        else
                        {
                            <partial name="_VtIcon" model='item.Icon + ":18"' />
                        }
                    </span>
                    @item.Text
                    @if (item.Key == "Notifications")
                    {
                        <span class="vt-sidebar__badge" data-vt-unread aria-label="@unreadCount unread" hidden="@(unreadCount == 0)">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
                    }
                </a>
            </li>
        }
    </ul>

    <button type="button" class="vt-sidebar__link vt-theme-toggle" data-vt-theme-toggle aria-pressed="false">
        <span class="vt-sidebar__icon" aria-hidden="true">
            <svg class="vt-theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
            <svg class="vt-theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </span>
        <span data-vt-theme-label>Dark mode</span>
    </button>

    @if (User.Identity?.IsAuthenticated == true)
    {
        var userRole = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Doctor") ? "Doctor" : User.IsInRole("Patient") ? "Patient" : null;
        <div class="vt-sidebar__user">
            <span class="vt-sidebar__user-icon"><partial name="_VtIcon" model='"user:18"' /></span>
            <span class="vt-sidebar__user-text">
                <span class="vt-sidebar__user-name" title="@User.Identity.Name">@(User.FindFirst("FullName")?.Value ?? User.Identity!.Name)</span>
                @if (userRole is not null) { <span class="vt-sidebar__user-role">@userRole</span> }
            </span>
        </div>
    }

    @* POST + anti-forgery token (added by the form tag helper). Backend adds [HttpPost] Account/Logout. *@
    <form class="vt-sidebar__logout" method="post" asp-controller="Account" asp-action="Logout">
        <button type="submit" class="vt-sidebar__link">
            <partial name="_VtIcon" model='"logout:20"' />
            Log out
        </button>
    </form>
</aside>
