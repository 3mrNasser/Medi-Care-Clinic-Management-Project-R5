@{
    var active = ViewData["ActiveNav"] as string ?? "";
    // Controller/action names are suggestions — rename to match the team's controllers.
    var items = new[]
    {
        (Key: "Home",          Text: "Home", Controller: "Patient", Action: "Home"),
        (Key: "Appointments",  Text: "Appointments", Controller: "MyAppointments", Action: "Index"),
        (Key: "AiAssistant",   Text: "AI Assistant", Controller: "Patient", Action: "AiAssistant"),
        (Key: "Cart",          Text: "Cart", Controller: "Patient", Action: "Cart"),
        (Key: "Notifications", Text: "Notifications", Controller: "Patient", Action: "Notifications"),
    };
}
<aside class="vt-sidebar" id="vt-sidebar" aria-label="Main navigation">
    <a class="vt-sidebar__brand" asp-controller="Home" asp-action="Index">vitala</a>
    <button type="button" class="vt-sidebar__close" data-vt-sidebar-close aria-label="Close menu">
        <partial name="_VtIcon" model='"close"' />
    </button>
    <ul class="vt-sidebar__nav">
        @foreach (var item in items)
        {
            var isActive = item.Key == active;
            <li>
                <a class="vt-sidebar__link @(isActive ? "is-active" : "")"
                   asp-controller="@item.Controller" asp-action="@item.Action"
                   aria-current="@(isActive ? "page" : null)">@item.Text</a>
            </li>
        }
    </ul>
</aside>
