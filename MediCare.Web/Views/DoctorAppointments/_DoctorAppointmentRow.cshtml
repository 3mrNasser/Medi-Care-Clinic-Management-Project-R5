@using MediCare.Data.Enums
@model MediCare.Services.DTOs.AppointmentDto
@{
    var doctorId = (int)ViewBag.DoctorId;
}
<article class="vt-row">
    <div class="vt-date" aria-hidden="true">
        <span class="vt-date__day">@Model.Date.Day</span>
        <span class="vt-date__mon">@Model.Date.ToString("MMM")</span>
    </div>
    <div>
        <h3 class="vt-row__title">@Model.PatientName</h3>
        <div class="vt-row__meta">
            <span><partial name="_VtIcon" model='"calendar:15"' /> @Model.Date.ToString("ddd, d MMM yyyy")</span>
            <span><partial name="_VtIcon" model='"clock:15"' /> @Model.StartTime.ToString("HH:mm")</span>
            @if (!string.IsNullOrWhiteSpace(Model.Reason))
            {
                <span>“@Model.Reason”</span>
            }
        </div>
    </div>
    <div class="vt-row__actions">
        <partial name="_VtStatusBadge" model="Model.Status" />
        @if (Model.Status == AppointmentStatus.Pending)
        {
            <form method="post" asp-controller="DoctorAppointments" asp-action="Confirm" class="vt-inline-form">
                <input type="hidden" name="doctorId" value="@doctorId" />
                <input type="hidden" name="appointmentId" value="@Model.Id" />
                <button type="submit" class="vt-btn vt-btn--success vt-btn--xs">Confirm</button>
            </form>
            <form method="post" asp-controller="DoctorAppointments" asp-action="Reject" class="vt-inline-form"
                  data-vt-confirm="Reject the appointment with @Model.PatientName?">
                <input type="hidden" name="doctorId" value="@doctorId" />
                <input type="hidden" name="appointmentId" value="@Model.Id" />
                <button type="submit" class="vt-btn vt-btn--danger vt-btn--xs">Reject</button>
            </form>
        }
        else if (Model.Status == AppointmentStatus.Confirmed)
        {
            <form method="post" asp-controller="DoctorAppointments" asp-action="Complete" class="vt-inline-form">
                <input type="hidden" name="doctorId" value="@doctorId" />
                <input type="hidden" name="appointmentId" value="@Model.Id" />
                <button type="submit" class="vt-btn vt-btn--primary vt-btn--xs">Completed</button>
            </form>
            <form method="post" asp-controller="DoctorAppointments" asp-action="NoShow" class="vt-inline-form"
                  data-vt-confirm="Mark @Model.PatientName as no-show?">
                <input type="hidden" name="doctorId" value="@doctorId" />
                <input type="hidden" name="appointmentId" value="@Model.Id" />
                <button type="submit" class="vt-btn vt-btn--outline vt-btn--xs">No-show</button>
            </form>
        }
        else if (Model.Status == AppointmentStatus.Completed)
        {
            <a class="vt-btn vt-btn--outline vt-btn--xs" asp-controller="Prescriptions" asp-action="Index"
               asp-route-doctorId="@doctorId" asp-route-appointmentId="@Model.Id">
                <partial name="_VtIcon" model='"pill:15"' /> Prescription
            </a>
        }
    </div>
</article>
