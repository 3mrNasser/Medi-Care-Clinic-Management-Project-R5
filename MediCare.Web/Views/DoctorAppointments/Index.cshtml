@using MediCare.Data.Enums
@model IEnumerable<MediCare.Services.DTOs.AppointmentDto>

@{
    ViewData["Title"] = "My appointments";
    var doctorId = (int)ViewBag.DoctorId;
}

<h2>My appointments</h2>

@if (TempData["Error"] is string error)
{
    <p style="color:red">@error</p>
}

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Patient</th>
            <th>Reason</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Date.ToString("yyyy-MM-dd")</td>
                <td>@a.StartTime.ToString("HH:mm")</td>
                <td>@a.PatientName</td>
                <td>@a.Reason</td>
                <td>@a.Status</td>
                <td>
                    @if (a.Status == AppointmentStatus.Pending)
                    {
                        <form method="post" asp-action="Confirm" style="display:inline">
                            <input type="hidden" name="doctorId" value="@doctorId" />
                            <input type="hidden" name="appointmentId" value="@a.Id" />
                            <button type="submit">Confirm</button>
                        </form>
                        <form method="post" asp-action="Reject" style="display:inline">
                            <input type="hidden" name="doctorId" value="@doctorId" />
                            <input type="hidden" name="appointmentId" value="@a.Id" />
                            <button type="submit">Reject</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>