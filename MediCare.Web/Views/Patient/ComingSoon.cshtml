@* Shared empty state for dashboard services that are in Figma but have no screen design yet
   (Pharmacy, Reward, Labs, e-Consultation, Medical History). Title / image / text come from PatientController. *@
@{
    Layout = "_DashboardLayout";
    var image = ViewData["Image"] as string;
}
<header class="vt-page-head">
    <button type="button" class="vt-menu-btn" data-vt-sidebar-open aria-controls="vt-sidebar" aria-label="Open menu">
        <partial name="_VtIcon" model='"menu"' />
    </button>
    <h1 class="vt-section-title">@ViewData["Title"]</h1>
</header>

<section class="vt-empty">
    <span class="vt-empty__icon vt-empty__icon--navy">
        @if (image is not null)
        {
            <img src="@Url.Content(image)" width="44" height="44" alt="" />
        }
        else
        {
            <partial name="_VtIcon" model='"reward:32"' />
        }
    </span>
    <h2 class="vt-empty__title">Coming soon</h2>
    <p class="vt-empty__text">@ViewData["Text"]</p>
    <a class="vt-btn vt-btn--primary vt-btn--sm" asp-controller="Patient" asp-action="Home">Back to Home</a>
</section>
