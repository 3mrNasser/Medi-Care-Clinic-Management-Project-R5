@using MediCare.Data.Enums
@* 1.2 — Patient Home Dashboard (Figma "1.2-Home-Web-Dashboard")
   Name: FullName claim of the signed-in patient. Upcoming appointment: ViewBag.NextAppointment (AppointmentDto?)
   + ViewBag.NextDoctor (DoctorDto?) from PatientController.Home.
   Service tiles: Doctor → Doctors/Index, Medical History → MyMedicalRecords; the others open "Coming soon".
*@
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Home";
    ViewData["ActiveNav"] = "Home";

    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;
    var next = ViewBag.NextAppointment as MediCare.Services.DTOs.AppointmentDto;
    var nextDoctor = ViewBag.NextDoctor as MediCare.Services.DTOs.DoctorDto;
    string WhenText(DateOnly date, TimeOnly time)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        var day = date == today ? "Today" : date == today.AddDays(1) ? "Tomorrow" : date.ToString("ddd, d MMM");
        return $"{day}, {time.ToString("h:mm tt")}";
    }

    // Icons exported from Figma (null = inline SVG fallback: the Reward export only contained its badge background).
    var services = new[]
    {
        (Name: "Doctor",          Image: (string?)"~/images/vitala/svc-doctor.png",          Icon: "doctor",  Controller: "Doctors", Action: "Index"),
        (Name: "Pharmacy",        Image: (string?)"~/images/vitala/svc-pharmacy.png",        Icon: "pharmacy", Controller: "Patient", Action: "Pharmacy"),
        (Name: "Reward",          Image: (string?)null,                                      Icon: "reward",  Controller: "Patient", Action: "Rewards"),
        (Name: "Labs",            Image: (string?)"~/images/vitala/svc-labs.png",            Icon: "labs",    Controller: "Patient", Action: "Labs"),
        (Name: "e-Consultation",  Image: (string?)"~/images/vitala/svc-econsultation.png",   Icon: "consult", Controller: "Patient", Action: "Consultation"),
        (Name: "Medical History", Image: (string?)"~/images/vitala/svc-medical-history.png", Icon: "history", Controller: "MyMedicalRecords", Action: "Index"),
    };
}

<header class="vt-topbar">
    <div class="vt-user">
        <div class="vt-avatar"><img src="~/images/vitala/patient-avatar.png" width="53" height="53" alt="" /></div>
        <div>
            <h1 class="vt-user__name">Hello, @firstName</h1>
            @* The Figma location line needs a patient address, which the account doesn't store yet. *@
        </div>
    </div>

    <div class="vt-topbar__actions">
        @* Searches doctors by name using the existing Doctors/Index?name=... filter *@
        <form class="vt-search" role="search" method="get" asp-controller="Doctors" asp-action="Index">
            <label for="vt-q" class="vt-sr-only">Search doctors</label>
            <partial name="_VtIcon" model='"search:20"' />
            <input id="vt-q" name="name" type="search" placeholder="Search doctors, labs, medicines..." />
        </form>
        <a class="vt-icon-btn" asp-controller="Patient" asp-action="Notifications" aria-label="Notifications">
            <partial name="_VtIcon" model='"bell:24"' />
            <span class="vt-icon-btn__dot"></span>
        </a>
        @* Figma "foundation:indent-more": collapses the sidebar (opens it on small screens) *@
        <button type="button" class="vt-icon-btn" data-vt-sidebar-toggle aria-controls="vt-sidebar" aria-label="Toggle menu">
            <partial name="_VtIcon" model='"indent:26"' />
        </button>
    </div>
</header>

<section class="vt-banner">
    <div>
        <h2 class="vt-banner__title">Medical Checks!</h2>
        <p class="vt-banner__text">Check your health condition regularly to minimize the incidence of disease in the future.</p>
        <a class="vt-btn vt-btn--white" asp-controller="Doctors" asp-action="Index">Check Now</a>
    </div>
    <div class="vt-banner__art" aria-hidden="true">
        <img src="~/images/vitala/banner-doctor.png" width="135" height="190" alt="" />
    </div>
</section>

<section aria-labelledby="vt-specialties-title">
    <div class="vt-section-head">
        <h2 class="vt-section-title" id="vt-specialties-title">Top Specialties</h2>
        <a class="vt-link-strong" asp-controller="Doctors" asp-action="Index">See all</a>
    </div>
    <div class="vt-specialties">
        @foreach (var s in services)
        {
            <a class="vt-specialty" asp-controller="@s.Controller" asp-action="@s.Action">
                <span class="vt-specialty__icon">
                    @if (s.Image is not null)
                    {
                        <img src="@Url.Content(s.Image)" width="50" height="50" alt="" />
                    }
                    else
                    {
                        <partial name="_VtIcon" model='s.Icon + ":34"' />
                    }
                </span>
                @s.Name
            </a>
        }
    </div>
</section>

<section class="vt-appointment" aria-label="Upcoming appointment">
    @if (next is not null)
    {
        <div>
            <span class="vt-eyebrow">Upcoming Appointment@(next.Status == AppointmentStatus.Pending ? " · waiting for confirmation" : "")</span>
            <h3 class="vt-appointment__doctor">
                @next.DoctorName@(string.IsNullOrWhiteSpace(nextDoctor?.Specialty) ? "" : $" — {nextDoctor!.Specialty}")
            </h3>
            <span class="vt-appointment__meta">
                @WhenText(next.Date, next.StartTime)@(string.IsNullOrWhiteSpace(nextDoctor?.ClinicAddress) ? "" : $" • {nextDoctor!.ClinicAddress}")
            </span>
        </div>
        <a class="vt-chip-link" asp-controller="MyAppointments" asp-action="Index">View Details</a>
    }
    else
    {
        <div>
            <span class="vt-eyebrow">Upcoming Appointment</span>
            <h3 class="vt-appointment__doctor">No upcoming appointments</h3>
            <span class="vt-appointment__meta">Find a specialist and book a time that suits you.</span>
        </div>
        <a class="vt-chip-link" asp-controller="Doctors" asp-action="Index">Book now</a>
    }
</section>

<a class="vt-fab" asp-controller="Patient" asp-action="AiAssistant" aria-label="Open AI Assistant" title="AI Assistant">
    <img src="~/images/vitala/bot.png" width="50" height="50" alt="" />
    <span class="vt-fab__dot" aria-hidden="true"></span>
</a>
