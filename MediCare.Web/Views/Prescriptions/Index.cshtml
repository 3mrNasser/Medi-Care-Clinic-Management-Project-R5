@model IEnumerable<MediCare.Services.DTOs.PrescriptionDto>
@* Doctor writes a prescription — GET /Prescriptions?doctorId=&appointmentId=,
   POST Prescriptions/Add (doctorId, appointmentId, medicationName, dosage, frequency, durationDays). Vitala style. *@
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Prescription";
    ViewData["ActiveNav"] = "DoctorAppointments";
    ViewData["SidebarRole"] = "Doctor";
    var doctorId = (int)ViewBag.DoctorId;
    var appointmentId = (int)ViewBag.AppointmentId;
}

<header class="vt-page-head">
    <button type="button" class="vt-menu-btn" data-vt-sidebar-open aria-controls="vt-sidebar" aria-label="Open menu">
        <partial name="_VtIcon" model='"menu"' />
    </button>
    <div class="vt-page-head__text">
        <h1 class="vt-page-title">Prescription</h1>
        <p class="vt-page-sub">Appointment #@appointmentId · add each medication the patient should take.</p>
    </div>
    <div class="vt-page-actions">
        <a class="vt-btn vt-btn--outline vt-btn--sm" asp-controller="MedicalRecords" asp-action="Edit"
           asp-route-doctorId="@doctorId" asp-route-appointmentId="@appointmentId">
            <partial name="_VtIcon" model='"history:18"' /> Medical record
        </a>
        <a class="vt-btn vt-btn--outline vt-btn--sm" asp-controller="DoctorAppointments" asp-action="Index" asp-route-doctorId="@doctorId">
            <partial name="_VtIcon" model='"back:18"' /> Back to appointments
        </a>
    </div>
</header>

<partial name="_VtAlerts" />

<section class="vt-card">
    <h2 class="vt-card__title">Add medication</h2>
    <form method="post" asp-controller="Prescriptions" asp-action="Add" class="vt-form-grid">
        <input type="hidden" name="doctorId" value="@doctorId" />
        <input type="hidden" name="appointmentId" value="@appointmentId" />
        <div class="vt-field">
            <label class="vt-label vt-label--sm" for="medicationName">Medication</label>
            <input class="vt-input vt-input--sm" id="medicationName" name="medicationName" maxlength="150" required placeholder="e.g. Paracetamol" />
        </div>
        <div class="vt-field">
            <label class="vt-label vt-label--sm" for="dosage">Dosage</label>
            <input class="vt-input vt-input--sm" id="dosage" name="dosage" maxlength="100" required placeholder="e.g. 500 mg" />
        </div>
        <div class="vt-field">
            <label class="vt-label vt-label--sm" for="frequency">Frequency</label>
            <input class="vt-input vt-input--sm" id="frequency" name="frequency" maxlength="100" required placeholder="e.g. twice a day" />
        </div>
        <div class="vt-field">
            <label class="vt-label vt-label--sm" for="durationDays">Days</label>
            <input class="vt-input vt-input--sm" id="durationDays" type="number" name="durationDays" min="1" required placeholder="e.g. 5" />
        </div>
        <div class="vt-field">
            <button type="submit" class="vt-btn vt-btn--primary vt-btn--sm vt-btn--block">
                <partial name="_VtIcon" model='"plus:18"' /> Add
            </button>
        </div>
    </form>
</section>

<section class="vt-card">
    <h2 class="vt-card__title">Medications</h2>
    @if (!Model.Any())
    {
        <p class="vt-muted">No medications added yet.</p>
    }
    else
    {
        <div class="vt-table-wrap">
            <table class="vt-table">
                <thead>
                    <tr><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Days</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><strong>@p.MedicationName</strong></td>
                            <td>@p.Dosage</td>
                            <td>@p.Frequency</td>
                            <td>@p.DurationDays</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
