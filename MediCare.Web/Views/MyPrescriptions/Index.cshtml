@model IEnumerable<MediCare.Services.DTOs.PrescriptionGroupDto>
@* Patient prescriptions — GET /MyPrescriptions. Printable: the sidebar, buttons and alerts are hidden when printing. *@
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Prescriptions";
    ViewData["ActiveNav"] = "Appointments";
}

<header class="vt-page-head">
    <button type="button" class="vt-menu-btn" data-vt-sidebar-open aria-controls="vt-sidebar" aria-label="Open menu">
        <partial name="_VtIcon" model='"menu"' />
    </button>
    <div class="vt-page-head__text">
        <h1 class="vt-page-title">My Prescriptions</h1>
        <p class="vt-page-sub">Medications from your completed appointments.</p>
    </div>
    @if (Model.Any())
    {
        <div class="vt-page-actions vt-no-print">
            <button type="button" class="vt-btn vt-btn--primary vt-btn--sm" onclick="window.print()">
                <partial name="_VtIcon" model='"print:18"' /> Print
            </button>
        </div>
    }
</header>

<p class="vt-print-only vt-muted">vitala · Printed @DateTime.Now.ToString("d MMM yyyy")</p>

@if (!Model.Any())
{
    <section class="vt-empty">
        <span class="vt-empty__icon vt-empty__icon--navy"><partial name="_VtIcon" model='"pill:30"' /></span>
        <h2 class="vt-empty__title">No prescriptions yet</h2>
        <p class="vt-empty__text">When a doctor writes you a prescription after a visit, it shows up here.</p>
        <a class="vt-btn vt-btn--primary vt-btn--sm" asp-controller="MyAppointments" asp-action="Index">My appointments</a>
    </section>
}

@foreach (var group in Model)
{
    <section class="vt-card vt-rx">
        <div class="vt-rx__head">
            <div>
                <span class="vt-eyebrow">Prescription</span>
                <h2 class="vt-rx__doctor">@group.DoctorName</h2>
            </div>
            <span class="vt-muted"><partial name="_VtIcon" model='"calendar:15"' /> @group.Date.ToString("d MMM yyyy")</span>
        </div>
        <div class="vt-table-wrap">
            <table class="vt-table">
                <thead>
                    <tr><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Days</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in group.Items)
                    {
                        <tr>
                            <td><strong>@p.MedicationName</strong></td>
                            <td>@p.Dosage</td>
                            <td>@p.Frequency</td>
                            <td>@p.DurationDays</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
