@{
    ViewData["Title"] = "Medical record";
    var doctorId = (int)ViewBag.DoctorId;
    var appointmentId = (int)ViewBag.AppointmentId;
    var diagnosis = (string)ViewBag.Diagnosis;
    var notes = (string)ViewBag.Notes;
    var hasRecord = (bool)ViewBag.HasRecord;
}

<h2>Medical record</h2>

<p>
    <a asp-controller="DoctorAppointments" asp-action="Index" asp-route-doctorId="@doctorId">Back to appointments</a>
</p>

@if (TempData["Error"] is string error)
{
    <p style="color:red">@error</p>
}
@if (TempData["Success"] is string success)
{
    <p style="color:green">@success</p>
}

<form method="post" asp-action="Save">
    <input type="hidden" name="doctorId" value="@doctorId" />
    <input type="hidden" name="appointmentId" value="@appointmentId" />

    <p>
        <label>
            Diagnosis<br />
            <input type="text" name="diagnosis" value="@diagnosis" maxlength="500" required />
        </label>
    </p>
    <p>
        <label>
            Notes<br />
            <textarea name="notes" rows="6" cols="60" maxlength="2000">@notes</textarea>
        </label>
    </p>

    <button type="submit">@(hasRecord ? "Update record" : "Save record")</button>
</form>