@* Doctor writes / updates the medical record of a completed appointment.
   GET /MedicalRecords/Edit?appointmentId=  (ViewBag: AppointmentId, Diagnosis, Notes, HasRecord)
   POST MedicalRecords/Save (appointmentId, diagnosis, notes?) → redirects back here with TempData Success/Error.
   Vitala style. *@
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Medical record";
    ViewData["ActiveNav"] = "DoctorAppointments";
    ViewData["SidebarRole"] = "Doctor";
    var appointmentId = (int)ViewBag.AppointmentId;
    var diagnosis = (string)ViewBag.Diagnosis;
    var notes = (string)ViewBag.Notes;
    var hasRecord = (bool)ViewBag.HasRecord;
}

<header class="vt-page-head">
    <button type="button" class="vt-menu-btn" data-vt-sidebar-open aria-controls="vt-sidebar" aria-label="Open menu">
        <partial name="_VtIcon" model='"menu"' />
    </button>
    <div class="vt-page-head__text">
        <h1 class="vt-page-title">Medical record</h1>
        <p class="vt-page-sub">Appointment #@appointmentId · @(hasRecord ? "update the diagnosis and notes." : "write the diagnosis and notes for this visit.")</p>
    </div>
    <div class="vt-page-actions">
        <a class="vt-btn vt-btn--outline vt-btn--sm" asp-controller="Prescriptions" asp-action="Index"
           asp-route-appointmentId="@appointmentId">
            <partial name="_VtIcon" model='"pill:18"' /> Prescription
        </a>
        <a class="vt-btn vt-btn--outline vt-btn--sm" asp-controller="DoctorAppointments" asp-action="Index">
            <partial name="_VtIcon" model='"back:18"' /> Back to appointments
        </a>
    </div>
</header>

<partial name="_VtAlerts" />

<section class="vt-card">
    <h2 class="vt-card__title">@(hasRecord ? "Edit record" : "New record")</h2>
    <form method="post" asp-controller="MedicalRecords" asp-action="Save" class="vt-list">
        <input type="hidden" name="appointmentId" value="@appointmentId" />

        <div class="vt-field">
            <label class="vt-label vt-label--sm" for="diagnosis">Diagnosis</label>
            <input class="vt-input vt-input--sm" id="diagnosis" name="diagnosis" value="@diagnosis" maxlength="500" required
                   placeholder="e.g. Seasonal allergic rhinitis" />
        </div>

        <div class="vt-field">
            <label class="vt-label vt-label--sm" for="notes">Notes <span class="vt-muted">(optional)</span></label>
            <textarea class="vt-input" id="notes" name="notes" rows="6" maxlength="2000"
                      placeholder="Symptoms, advice, follow-up…">@notes</textarea>
        </div>

        <div>
            <button type="submit" class="vt-btn vt-btn--primary vt-btn--sm">
                <partial name="_VtIcon" model='"check-circle:18"' /> @(hasRecord ? "Update record" : "Save record")
            </button>
        </div>
    </form>
</section>
